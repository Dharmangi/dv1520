PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dv1520
API_KEY=replace-with-a-long-random-secret

# Secures POST /internal/update-version, called only by the release CI pipeline.
# Must match the INTERNAL_UPDATE_TOKEN GitHub Actions secret exactly. Generate a
# long random value, e.g.: openssl rand -hex 32
INTERNAL_UPDATE_TOKEN=replace-with-a-long-random-secret

# In-app update check (GET /api/version). The source of truth is the AppVersion
# document in MongoDB, kept in sync automatically by CI via
# POST /internal/update-version after every release — no manual editing needed.
# The values below are seed/fallback defaults, only used if no release has been
# synced yet (e.g. on a fresh database).
APP_LATEST_VERSION=1.0.2
APP_FORCE_UPDATE=false
APP_RELEASE_NOTES=Bug fixes and UI improvements
# Optional: override the default GitHub Releases URL pattern below.
GITHUB_REPO=Dharmangi/dv1520
# APP_APK_URL=https://github.com/Dharmangi/dv1520/releases/download/v1.0.2/app-release.apk
